# Navigate to backend directory
cd backend  # or your backend folder name

# Create .gitignore file
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.production
.env.development
.env.test

# Build outputs
dist/
build/
out/

# Logs
logs/
*.log
*.log.*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# parcel-bundler cache
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TypeScript cache
*.tsbuildinfo

# Optional REPL history
.node_repl_history

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Uploads
uploads/
temp/
tmp/

# Database files
*.sqlite
*.sqlite3
*.db

# SSL certificates
*.pem
*.key
*.crt

# PM2
.pm2/

# Redis
dump.rdb

# Docker
*.log
*.pid
*.seed

# Backup files
*.bak
*.backup
*.old

# Error logs
err.log
out.log

# API documentation
apidoc/

# Testing
test-results/
junit.xml

# Secret files
*.p12
*.pfx
secrets.json
credentials.json
EOF