# Navigate to project root
cd ../  # if you're in frontend/backend

# Create root .gitignore
cat > .gitignore << 'EOF'
# Root level .gitignore for full project

# Backend
backend/node_modules/
backend/.env
backend/package-lock.json
backend/yarn.lock
backend/logs/
backend/uploads/
backend/temp/
backend/coverage/

# Frontend
frontend/node_modules/
frontend/.env
frontend/package-lock.json
frontend/yarn.lock
frontend/build/
frontend/dist/
frontend/coverage/

# Common
.DS_Store
Thumbs.db
*.log
*.tmp
*.temp
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files
.env
.env.*
!.env.example

# Dependency directories
node_modules/

# Build outputs
dist/
build/
out/

# IDE files
.vscode/
.idea/
*.iml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Optional eslint cache
.eslintcache

# dotenv environment files
.env
.env.test
.env.production

# parcel-bundler cache
.cache

# Backup files
*.bak
*.backup
*.old

# Secret files
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
credentials.json

# Database files
*.db
*.sqlite
*.sqlite3

# Session data
.session
.sessions

# Temporary files
tmp/
temp/
*.tmp

# Git
*.orig
*.rej

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# Documentation
docs/_build/
site/

# Testing
test-results/
junit.xml
EOF